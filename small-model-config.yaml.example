# Copy the relevant sections into $HERMES_HOME/config.yaml.
# This template minimizes always-on context and routes local inference through
# an explicit Headroom-aware fleet without removing tools or skills.

model:
  provider: custom
  default: local-coder
  base_url: http://127.0.0.1:8765/v1

  # Use a conservative context available across the nodes intended for the main
  # agent. The fleet router separately rejects any node that cannot fit a
  # specific request plus its requested output and safety margin.
  context_length: 32768

fleet:
  enabled: true
  health_ttl_seconds: 30
  default_max_output_tokens: 4096
  max_attempts: 2

  # Loopback is the safe default. A non-loopback bind must be explicitly enabled
  # and should also set token_env to a dedicated inbound bearer token.
  listen:
    host: 127.0.0.1
    port: 8765
    allow_non_loopback: false
    # token_env: HERMES_FLEET_LISTEN_TOKEN

  # Only explicitly listed nodes are contacted. There are no built-in hostnames,
  # tailnet names, subnet scans, or implicitly forwarded provider credentials.
  nodes:
    - name: primary-large
      base_url: http://primary-large.lan:1234/v1
      provider: lmstudio
      context_length: 32768
      max_concurrency: 1
      prefill_tokens_per_second: 80
      decode_tokens_per_second: 18
      supports_tools: true
      supports_vision: false
      supports_reasoning: true
      models:
        - local-large-model-id
      model_map:
        local-coder: local-large-model-id

    - name: fast-small
      base_url: http://fast-small.lan:1234/v1
      provider: lmstudio
      context_length: 16384
      max_concurrency: 2
      prefill_tokens_per_second: 120
      decode_tokens_per_second: 30
      supports_tools: true
      supports_vision: false
      supports_reasoning: true
      models:
        - local-small-model-id
      model_map:
        local-fast: local-small-model-id

    # A protected node receives only this explicitly named credential. Inbound
    # proxy Authorization and OPENAI_API_KEY are never forwarded automatically.
    # - name: protected
    #   base_url: http://protected-node.lan:8000/v1
    #   api_key_env: PROTECTED_NODE_API_KEY
    #   context_length: 65536
    #   models: [private-model]

agent:
  # auto selects lean <=32K, balanced through 128K, and full above 128K.
  context_profile: auto

  # Coding sessions use the coding toolset plus explicitly enabled MCP servers.
  # This is the largest safe schema reduction already supported by Hermes.
  coding_context: focus

  # Retain batching guidance because fewer model round-trips matter even more on
  # slow local inference.
  parallel_tool_call_guidance: true

  # Keep completion discipline on unless the selected model already follows
  # through reliably; disabling it saves prompt tokens but can increase stubs.
  task_completion_guidance: true

context_optimizer:
  profile: auto
  skills: auto
  tools: auto

  # Used only when the selected mode is compact.
  tool_description_chars: 180
  parameter_description_chars: 96
  skill_description_chars: 120

# For repositories without a concise .hermes.md/HERMES.md, bound the fallback
# AGENTS.md/CLAUDE.md/.cursorrules injection. The omitted content remains
# available through read_file when the current task needs it.
context_file_max_chars: 6000

compression:
  enabled: true
  protect_first_n: 0
  protect_last_n: 16
  min_tail_user_messages: 3
  max_attempts: 4

  # Rewriting past history invalidates the current provider prefix cache. Keep
  # proactive pruning disabled until measured context pressure justifies it.
  proactive_prune_tokens: 0
  proactive_prune_min_result_chars: 8000
  proactive_prune_min_reclaim_tokens: 4096

plugins:
  enabled:
    - small-model-context
    - fleet-router
    - rtk-rewrite
    - cache-foundation

# Add knowledge_graph when Neo4j is configured. It remains a single-select
# external provider and should keep raw reasoning/tool capture disabled.
memory:
  provider: knowledge_graph

knowledge_graph:
  enabled: true
  uri: bolt://127.0.0.1:7687
  user: neo4j
  database: neo4j
  capture_reasoning: false
  capture_tool_arguments: false
  capture_tool_results: false

# Worktree isolation prevents concurrent coding agents from editing the same
# checkout. Prefer ssh/docker terminal isolation when available.
worktree: true
worktree_sync: true

terminal:
  backend: local
  timeout: 180

# Smaller models benefit from a lower iteration ceiling and explicit delegation
# budgets. Raise only after measuring successful completion behavior.
max_concurrent_sessions: 2
