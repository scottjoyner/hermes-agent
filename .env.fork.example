# Hermes fork profile environment template
#
# Copy only the variables you need into $HERMES_HOME/.env, normally:
#   ~/.hermes/.env
#
# Hermes loads the profile-local file before a project .env. Never commit the
# populated profile file.

# =============================================================================
# Neo4j knowledge-graph memory
# =============================================================================

# NEO4J_URI=bolt://127.0.0.1:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=replace-me
# NEO4J_DATABASE=neo4j

# Comma-separated OpenAI-compatible embedding endpoints, attempted in order.
# HERMES_KG_EMBEDDINGS_URLS=http://xwing:1234/v1,http://tie:1234/v1
# HERMES_KG_EMBEDDINGS_MODEL=nomic-embed-text
# HERMES_KG_EMBEDDINGS_API_KEY=

# =============================================================================
# RTK command-output compression
# =============================================================================

# Leave unset for the default `rtk` binary from PATH.
# HERMES_RTK_BINARY=/usr/local/bin/rtk
# HERMES_RTK_REWRITE_TIMEOUT=2
# HERMES_RTK_DISABLE=0

# =============================================================================
# Cache-aware inference foundation
# =============================================================================

# Exact UTF-8 prefix of the outgoing Hermes system prompt. The plugin uses this
# file only on a byte-for-byte prefix match.
# HERMES_CACHE_STABLE_PREFIX_FILE=~/.hermes/cache/prompts/primary-cli-coding.txt

# Exact runtime identity for reproducible backend-managed checkpoints.
# HERMES_CACHE_ENGINE_ID=llama.cpp
# HERMES_CACHE_ENGINE_FINGERPRINT=llama.cpp-b6123
# HERMES_CACHE_MODEL_FINGERPRINT=Qwen3.5-35B-A3B-Q4_K_M:sha256:replace-me
# HERMES_CACHE_CHAT_TEMPLATE_HASH=sha256:replace-me
# HERMES_CACHE_KV_FORMAT=q8_0-k/q4_0-v

# Optional key used only by explicit `hermes cache warm` requests.
# HERMES_CACHE_API_KEY=

# Keep unset unless the endpoint is a deliberately trusted cache-aware proxy.
# This setting permits opaque session/cache identifiers to leave the private
# endpoint trust boundary.
# HERMES_CACHE_ALLOW_REMOTE=0

# HERMES_CACHE_MODE=prefer
# HERMES_CACHE_STATE_DB=~/.hermes/cache/state.db
# HERMES_CACHE_DISABLE=0

# =============================================================================
# Fork operations and drift diagnostics
# =============================================================================

# Defaults are normally correct. Override only for a deliberate topology.
# HERMES_FORK_UPSTREAM_URL=https://github.com/NousResearch/hermes-agent.git
# HERMES_FORK_BASE_REF=origin/main
# HERMES_FORK_UPSTREAM_REF=upstream/main
